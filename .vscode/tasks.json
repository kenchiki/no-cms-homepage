{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "差分ビルド",
      "type": "process",
      "command": "docker",
      "args": ["compose", "run", "--build", "--rm", "-T", "app", "npm", "run", "build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "フルビルド",
      "type": "process",
      "command": "docker",
      "args": ["compose", "run", "--build", "--rm", "-T", "app", "npm", "run", "build:full"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "型チェック",
      "type": "process",
      "command": "docker",
      "args": ["compose", "run", "--build", "--rm", "-T", "app", "npm", "run", "typecheck"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "プレビューを起動",
      "type": "process",
      "command": "docker",
      "args": ["compose", "up", "--wait", "preview"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "プレビューを停止",
      "type": "process",
      "command": "docker",
      "args": ["compose", "stop", "preview"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
