{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Diff Build",
      "type": "process",
      "command": "docker",
      "args": ["compose", "run", "--build", "--rm", "-T", "app", "npm", "run", "build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Full Build",
      "type": "process",
      "command": "docker",
      "args": ["compose", "run", "--build", "--rm", "-T", "app", "npm", "run", "build:full"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build CSS",
      "type": "process",
      "command": "docker",
      "args": ["compose", "run", "--build", "--rm", "-T", "app", "npm", "run", "build:css"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Format TypeScript",
      "type": "process",
      "command": "docker",
      "args": ["compose", "run", "--build", "--rm", "-T", "app", "npm", "run", "format"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Check Types",
      "type": "process",
      "command": "docker",
      "args": ["compose", "run", "--build", "--rm", "-T", "app", "npm", "run", "typecheck"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Test",
      "type": "process",
      "command": "docker",
      "args": ["compose", "run", "--build", "--rm", "-T", "app", "npm", "test"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Preview Start",
      "type": "process",
      "command": "docker",
      "args": ["compose", "up", "--wait", "preview"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Preview Stop",
      "type": "process",
      "command": "docker",
      "args": ["compose", "stop", "preview"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
